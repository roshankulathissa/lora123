modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/lora-web run dev"
waitForPort = 5000

[[ports]]
localPort = 5001
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["pnpm", "--filter", "@workspace/lora-web", "run", "build"]
publicDir = "artifacts/lora-web/dist"

[userenv]

